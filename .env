# Options: "claude" (needs ANTHROPIC_API_KEY) or "ollama" (local, no key needed)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# --- OCR (scanned pages / image notes) ----------------------------------------
# Path to the Tesseract binary if it's not on PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=
# Language(s) for Tesseract, e.g. "eng" or "eng+deu".
OCR_LANG=eng
# A PDF page with fewer than this many non-whitespace chars of extracted text
# is treated as scanned and OCR'd.
OCR_MIN_CHARS=30
# Preprocessing before OCR: unset (grayscale only), "contrast" (autocontrast),
# or "threshold" (autocontrast + binarize; try for faint scans).
# OCR_PREPROCESS=contrast

# --- OCR engines (handwritten notes) -------------------------------------------
# Engine: tesseract (local, fast, free) | claude (Anthropic vision API, best on
# handwriting; page images leave the machine) | ollama (local vision model) |
# auto (tesseract first, low-confidence pages escalate to OCR_VISION_ENGINE).
OCR_ENGINE=tesseract
# For auto: which vision engine handles escalated pages.
OCR_VISION_ENGINE=claude
# Mean word confidence below which auto escalates (0-100).
# OCR_CONF_THRESHOLD=60
# Claude vision model for OCR.
# OCR_CLAUDE_MODEL=claude-sonnet-4-20250514
# Ollama vision model for OCR (pull it first, e.g. `ollama pull llama3.2-vision`).
# OCR_OLLAMA_MODEL=llama3.2-vision
# Max pages per ingest run allowed to use a vision engine (cost control);
# pages beyond the cap fall back to Tesseract.
# OCR_MAX_VISION_PAGES=50
